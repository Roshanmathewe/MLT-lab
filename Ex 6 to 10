# Experiment 6 – Implementation of Hierarchical Clustering Algorithms

Dataset: `Kasol.csv`

## Objective
To implement hierarchical agglomerative clustering and analyze cluster quality using silhouette score, Davies-Bouldin index, and dendrograms.

### Q1. Load the dataset
```python
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

df = pd.read_csv("Kasol.csv")

print(df.head())
print(df.info())
print(df.shape)
print(df.isnull().sum())
```

### Q2. Preprocess the data
```python
from sklearn.preprocessing import StandardScaler

df = df.dropna()
df = pd.get_dummies(df, drop_first=True, dtype=int)

print(df.head())
```

### Q3. Remove the target variable if present
```python
X = df.drop(
    columns=['Discharge', 'Unnamed: 0'],
    errors='ignore'
)

print(X.head())
```

### Q4. Plot data points
```python
plt.figure(figsize=(8, 5))
plt.scatter(X.iloc[:, 0], X.iloc[:, 1])
plt.xlabel(X.columns[0])
plt.ylabel(X.columns[1])
plt.title("Original Data Points")
plt.show()
```

### Q5. Apply hierarchical agglomerative clustering using single linkage
```python
from sklearn.cluster import AgglomerativeClustering

scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

model = AgglomerativeClustering(
    n_clusters=3,
    linkage='single'
)

labels = model.fit_predict(X_scaled)

print("Cluster Labels:")
print(labels)

df['Cluster'] = labels
```

### Q6. Determine the optimal number of clusters using dendrogram
```python
from scipy.cluster.hierarchy import dendrogram, linkage

linked = linkage(X_scaled, method='single')

plt.figure(figsize=(12, 6))
dendrogram(linked)
plt.title("Hierarchical Clustering Dendrogram")
plt.xlabel("Data Points")
plt.ylabel("Euclidean Distance")
plt.show()
```

### Q7. Print and plot the cluster centroids and labels
```python
df['Cluster'] = labels

centroids = df.groupby('Cluster')[X.columns].mean()

print("Cluster Centroids:")
print(centroids)

plt.figure(figsize=(8, 5))
plt.scatter(
    X_scaled[:, 0],
    X_scaled[:, 1],
    c=labels,
    cmap='rainbow'
)

plt.scatter(
    centroids.iloc[:, :2].to_numpy()[:, 0],
    centroids.iloc[:, :2].to_numpy()[:, 1],
    marker='X',
    s=200
)

plt.title("Hierarchical Clustering")
plt.show()
```

### Q8. Repeat the clustering for different cluster sizes
```python
for k in [2, 3, 4, 5]:
    model = AgglomerativeClustering(
        n_clusters=k,
        linkage='single'
    )
    labels = model.fit_predict(X_scaled)

    print("Number of Clusters:", k)
    print("Cluster Labels:")
    print(labels)
```

### Q9. Evaluate clustering performance
```python
from sklearn.metrics import silhouette_score, davies_bouldin_score

for k in [2, 3, 4, 5]:
    model = AgglomerativeClustering(
        n_clusters=k,
        linkage='single'
    )
    labels = model.fit_predict(X_scaled)

    print("Clusters:", k)
    print("Silhouette Score:", silhouette_score(X_scaled, labels))
    print("Davies-Bouldin Index:", davies_bouldin_score(X_scaled, labels))
```

### Q10. Plot cluster centroids for different cluster values
```python
for k in [2, 3, 4, 5]:
    model = AgglomerativeClustering(
        n_clusters=k,
        linkage='single'
    )
    labels = model.fit_predict(X_scaled)

    centroids = pd.DataFrame(X_scaled).groupby(labels).mean()

    print("Number of Clusters:", k)
    print("Centroids:")
    print(centroids)

    plt.figure(figsize=(8, 5))
    plt.scatter(X_scaled[:, 0], X_scaled[:, 1], c=labels, cmap='rainbow')
    plt.title("Hierarchical Clustering - " + str(k))
    plt.show()

    result = X.copy()
    result['Cluster'] = labels
    result.to_csv(f"Hierarchical_Clusters_{k}.csv", index=False)
```

