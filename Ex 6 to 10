EXPERIMENT 8 – IMPLEMENTATION OF SELF-ORGANIZING MAP (SOM)
Dataset: HR Data.csv

Q1. Install and import the required libraries for implementing Self-Organizing Map.
!pip install minisom

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

from minisom import MiniSom

from sklearn.preprocessing import StandardScaler

from sklearn.cluster import KMeans

from sklearn.metrics import (
    silhouette_score,
    davies_bouldin_score
)
Q2. Load the HR dataset and display its basic information.
df = pd.read_csv("HR Data.csv")

print(df.head())

print(df.info())

print(df.shape)

print(df.isnull().sum())
Q3. Preprocess the HR dataset and remove the target variable.
df = df.dropna()

X = df.select_dtypes(include=np.number)

X = X.drop(
    columns=['left'],
    errors='ignore'
)

print(X.head())
Q4. Standardize the HR dataset before applying SOM.
scaler = StandardScaler()

X_scaled = scaler.fit_transform(X)

print(X_scaled)
Q5. Plot the original data points of the HR dataset.
plt.figure(figsize=(8, 5))

plt.scatter(
    X_scaled[:, 0],
    X_scaled[:, 1]
)

plt.xlabel("Feature 1")

plt.ylabel("Feature 2")

plt.title("Original Data Points")

plt.show()
Q6. Apply the Self-Organizing Map algorithm to the HR dataset.
som = MiniSom(
    x=10,
    y=10,
    input_len=X_scaled.shape[1],
    sigma=1.0,
    learning_rate=0.5,
    random_seed=42
)

som.random_weights_init(X_scaled)

som.train_random(
    X_scaled,
    num_iteration=100
)

print("SOM Training Completed")
Q7. Calculate the cluster centroids from the SOM cluster labels.
bmu = np.array([
    som.winner(x) for x in X_scaled
])

coordinates = bmu.reshape(len(X_scaled), 2)

kmeans = KMeans(
    n_clusters=3,
    random_state=42,
    n_init=10
)

labels = kmeans.fit_predict(coordinates)

centroids = pd.DataFrame(
    X_scaled
).groupby(labels).mean()

print("Cluster Centroids:")
print(centroids)
Q8. Calculate the Silhouette Score and Davies-Bouldin Score.
sil = silhouette_score(
    X_scaled,
    labels
)

db = davies_bouldin_score(
    X_scaled,
    labels
)

print("Silhouette Score:", sil)

print("Davies-Bouldin Score:", db)
Q9. Repeat the SOM algorithm for different numbers of clusters.
for k in [2, 3, 4, 5]:

    kmeans = KMeans(
        n_clusters=k,
        random_state=42,
        n_init=10
    )

    labels = kmeans.fit_predict(coordinates)

    sil = silhouette_score(X_scaled, labels)

    db = davies_bouldin_score(X_scaled, labels)

    print("Clusters:", k)

    print("Silhouette Score:", sil)

    print("Davies-Bouldin Score:", db)
Q10. Plot the Silhouette Score and Davies-Bouldin Score for different numbers of clusters.
sil_scores = []

db_scores = []

cluster_values = [2, 3, 4, 5]

for k in cluster_values:

    km = KMeans(
        n_clusters=k,
        random_state=42,
        n_init=10
    )

    labels = km.fit_predict(coordinates)

    sil_scores.append(
        silhouette_score(X_scaled, labels)
    )

    db_scores.append(
        davies_bouldin_score(X_scaled, labels)
    )

plt.plot(
    cluster_values,
    sil_scores,
    marker='o'
)

plt.xlabel("Number of Clusters")

plt.ylabel("Silhouette Score")

plt.title("Silhouette Score")

plt.show()

plt.plot(
    cluster_values,
    db_scores,
    marker='o'
)

plt.xlabel("Number of Clusters")

plt.ylabel("Davies-Bouldin Score")

plt.title("Davies-Bouldin Score")

plt.show()
Q11. Determine and apply the final number of clusters.
best_k = cluster_values[
    np.argmax(sil_scores)
]

print("Optimal Number of Clusters:", best_k)

final_model = KMeans(
    n_clusters=best_k,
    random_state=42,
    n_init=10
)

final_labels = final_model.fit_predict(coordinates)

print(final_labels)
Q12. Print the final cluster centroids and cluster labels.
final_centroids = pd.DataFrame(
    X_scaled
).groupby(final_labels).mean()

print("Final Cluster Labels:")
print(final_labels)

print("Final Cluster Centroids:")
print(final_centroids)
Q13. Plot the final SOM clusters and cluster centroids.
plt.figure(figsize=(8, 5))

plt.scatter(
    X_scaled[:, 0],
    X_scaled[:, 1],
    c=final_labels,
    cmap='rainbow'
)

plt.title("Final SOM Clustering")

plt.xlabel("Feature 1")

plt.ylabel("Feature 2")

plt.show()
EXPERIMENT 9 – ASSOCIATION RULE LEARNING USING APRIORI ALGORITHM
Dataset: Shop2.csv

Minimum Support: 0.08

Minimum Confidence: 0.50

Q1. Load a dataset of transactions from a CSV file.
!pip install mlxtend

import pandas as pd
import numpy as np

from mlxtend.preprocessing import TransactionEncoder

from mlxtend.frequent_patterns import (
    apriori,
    association_rules
)

df = pd.read_csv("Shop2.csv")

print(df.head())

print(df.shape)
Q2. Identify frequent itemsets using the Apriori algorithm.
transactions = []

for row in df.values:

    items = [
        str(item).strip()
        for item in row
        if pd.notna(item)
    ]

    transactions.append(items)

te = TransactionEncoder()

te_array = te.fit(
    transactions
).transform(transactions)

basket = pd.DataFrame(
    te_array,
    columns=te.columns_
)

print(basket.head())

frequent_itemsets = apriori(
    basket,
    min_support=0.08,
    use_colnames=True
)

print("Frequent Itemsets:")

print(frequent_itemsets)
Q3. Generate association rules based on a minimum confidence threshold.
rules = association_rules(
    frequent_itemsets,
    metric="confidence",
    min_threshold=0.50
)

print("Association Rules:")

print(
    rules[
        ['antecedents', 'consequents',
         'support', 'confidence', 'lift']
    ]
)
Q4. Extract rules with higher confidence values.
high_confidence = rules[
    rules['confidence'] > 0.70
]

print("High Confidence Rules:")

print(
    high_confidence[
        ['antecedents', 'consequents',
         'support', 'confidence', 'lift']
    ]
)
