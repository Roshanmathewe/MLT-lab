# Experiment 8 – Implementation of Self-Organizing Map (SOM)

Dataset: `HR Data.csv`

## Objective
To apply Self-Organizing Map (SOM) for clustering and evaluate cluster quality.

### Q1. Install and import required libraries
```python
!pip install minisom

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

from minisom import MiniSom
from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score, davies_bouldin_score
```

### Q2. Load the HR dataset
```python
df = pd.read_csv("HR Data.csv")

print(df.head())
print(df.info())
print(df.shape)
print(df.isnull().sum())
```

### Q3. Preprocess and remove target variable
```python
df = df.dropna()

X = df.select_dtypes(include=np.number)
X = X.drop(columns=['left'], errors='ignore')

print(X.head())
```

### Q4. Standardize the data
```python
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

print(X_scaled)
```

### Q5. Plot original data
```python
plt.figure(figsize=(8, 5))
plt.scatter(X_scaled[:, 0], X_scaled[:, 1])
plt.xlabel("Feature 1")
plt.ylabel("Feature 2")
plt.title("Original Data Points")
plt.show()
```

### Q6. Train the SOM
```python
som = MiniSom(
    x=10,
    y=10,
    input_len=X_scaled.shape[1],
    sigma=1.0,
    learning_rate=0.5,
    random_seed=42
)

som.random_weights_init(X_scaled)

som.train_random(X_scaled, num_iteration=100)

print("SOM Training Completed")
```

### Q7. Calculate cluster centroids from BMUs
```python
bmu = np.array([som.winner(x) for x in X_scaled])
coordinates = bmu.reshape(len(X_scaled), 2)

kmeans = KMeans(
    n_clusters=3,
    random_state=42,
    n_init=10
)

labels = kmeans.fit_predict(coordinates)

centroids = pd.DataFrame(X_scaled).groupby(labels).mean()

print("Cluster Centroids:")
print(centroids)
```

### Q8. Evaluate performance
```python
sil = silhouette_score(X_scaled, labels)
db = davies_bouldin_score(X_scaled, labels)

print("Silhouette Score:", sil)
print("Davies-Bouldin Score:", db)
```

### Q9. Repeat SOM-based clustering for different cluster counts
```python
for k in [2, 3, 4, 5]:
    kmeans = KMeans(
        n_clusters=k,
        random_state=42,
        n_init=10
    )

    labels = kmeans.fit_predict(coordinates)

    sil = silhouette_score(X_scaled, labels)
    db = davies_bouldin_score(X_scaled, labels)

    print("Clusters:", k)
    print("Silhouette Score:", sil)
    print("Davies-Bouldin Score:", db)
```

### Q10. Plot silhouette and Davies-Bouldin score
```python
sil_scores = []
db_scores = []
cluster_values = [2, 3, 4, 5]

for k in cluster_values:
    km = KMeans(
        n_clusters=k,
        random_state=42,
        n_init=10
    )

    labels = km.fit_predict(coordinates)

    sil_scores.append(silhouette_score(X_scaled, labels))
    db_scores.append(davies_bouldin_score(X_scaled, labels))

plt.plot(cluster_values, sil_scores, marker='o')
plt.xlabel("Number of Clusters")
plt.ylabel("Silhouette Score")
plt.title("Silhouette Score")
plt.show()

plt.plot(cluster_values, db_scores, marker='o')
plt.xlabel("Number of Clusters")
plt.ylabel("Davies-Bouldin Score")
plt.title("Davies-Bouldin Score")
plt.show()
```

### Q11. Determine the final number of clusters
```python
best_k = cluster_values[np.argmax(sil_scores)]

print("Optimal Number of Clusters:", best_k)

final_model = KMeans(
    n_clusters=best_k,
    random_state=42,
    n_init=10
)

final_labels = final_model.fit_predict(coordinates)

print(final_labels)
```

### Q12. Print final cluster centroids and labels
```python
final_centroids = pd.DataFrame(X_scaled).groupby(final_labels).mean()

print("Final Cluster Labels:")
print(final_labels)

print("Final Cluster Centroids:")
print(final_centroids)
```

### Q13. Plot final SOM clustering result
```python
plt.figure(figsize=(8, 5))
plt.scatter(X_scaled[:, 0], X_scaled[:, 1], c=final_labels, cmap='rainbow')
plt.title("Final SOM Clustering")
plt.xlabel("Feature 1")
plt.ylabel("Feature 2")
plt.show()
```

